QWidget {font-family:"Noto Sans CJK SC","Noto Sans",sans-serif;font-size:13px;color:#363847;selection-background-color:#e5eaf8;selection-color:#4d5368;}
QFrame#shell {background:#fdfdfe;border:1px solid #e0e2e9;border-radius:14px;}
QFrame#reminderShell {background:#fdfdff;border:2px solid #7d8ccd;border-radius:16px;}
QLabel#reminderStatus {color:#7d8ccd;font-size:13px;font-weight:600;}
QFrame#sidebar {background:#f4f5f9;border-bottom-left-radius:13px;border-right:1px solid #eceef5;}
QLabel#brand {font-size:28px;font-weight:600;color:#434758;}
QLabel#heading {font-size:29px;font-weight:600;color:#343746;}
QLabel#detailTitle {font-size:18px;font-weight:500;color:#4d5368;}
QLabel#taskTitle {font-size:13px;font-weight:500;color:#4d5368;}
QLabel#muted {color:#8c8f9f;font-size:11px;}
QLabel#tiny {color:#a2a6b6;font-size:10px;}
QLabel#eyebrow,QLabel#chromeCaption {color:#a2a6b6;font-size:10px;letter-spacing:1px;}
QLabel#sectionLabel {font-size:11px;font-weight:500;color:#777c90;}
QPushButton {background:#f1f3f8;border:1px solid transparent;border-radius:8px;padding:9px 13px;color:#747a91;font-size:12px;}
QPushButton:hover {background:#e9ecf5;color:#4d5368;}
QPushButton:pressed {background:#e5eaf8;}
QPushButton:focus {border:1px solid #7d8ccd;}
QPushButton:disabled {color:#a2a6b6;background:#f6f7fa;}
QPushButton#primary {background:#7d8ccd;color:white;padding:10px 17px;}
QPushButton#primary:disabled {background:#f1f3f8;color:#a2a6b6;}
QPushButton#primary:hover {background:#6e80c5;color:white;}
QPushButton#windowControl {border:0;background:transparent;padding:0;font-size:17px;}
QPushButton#windowControl:hover {background:#e9ecf5;}
QPushButton#textButton {background:transparent;border:0;text-align:left;padding:7px 0;font-size:11px;color:#8c8f9f;}
QPushButton#petButton {background:#e5eaf8;padding:7px;font-size:10px;color:#747a91;}
QFrame#companion {background:#eef0f8;border:1px solid #e8ebf5;border-radius:12px;}
QFrame#statCard {background:#f6f7fa;border:1px solid #eceef5;border-radius:11px;}
QLabel#statNumber {font-size:24px;color:#7d8ccd;}
QListWidget {background:transparent;border:0;outline:0;}
QTreeWidget#historyTree {background:transparent;border:0;outline:0;color:#4d5368;font-size:12px;}
QTreeWidget#historyTree::item {padding:9px 5px;border-radius:7px;}
QTreeWidget#historyTree::item:hover {background:#f6f7fa;}
QTreeWidget#historyTree::item:selected {background:#e5eaf8;color:#4d5368;}
QListWidget#nav::item {border-radius:9px;padding:0 12px;margin:3px 0;color:#8c8f9f;}
QListWidget#nav::item:hover {background:#e9ecf5;}
QListWidget#nav::item:selected {background:#e5eaf8;color:#7d8ccd;font-weight:500;}
QListWidget#sessions::item {border:0;background:transparent;}
QListWidget#sessions::item:selected {background:#e5eaf8;border-radius:12px;}
QFrame#sessionRow {border:1px solid #eceef5;border-radius:12px;background:transparent;}
QFrame#sessionRow:hover {background:#f6f7fa;}
QFrame#sessionRowSelected {border:1px solid #7d8ccd;border-radius:12px;background:transparent;}
QLabel#unread {font-size:10px;color:#9c774b;background:#fff6e9;border-radius:5px;padding:3px 6px;}
QFrame#detail {border:1px solid #eceef5;background:#fdfdff;border-radius:12px;}
QTextBrowser {border:0;background:transparent;color:#4d5368;font-size:12px;selection-background-color:#e5eaf8;}
QLabel#question {background:#fff6e9;color:#9c774b;padding:12px;border-radius:9px;font-size:11px;}
QLabel#banner {background:#fff6e9;color:#9c774b;padding:9px;border-radius:8px;font-size:10px;}
QLineEdit {background:#f6f7fa;border:1px solid #eceef5;border-radius:8px;padding:9px;color:#747a91;}
QLineEdit:focus {border-color:#7d8ccd;}
QLineEdit#search {font-size:11px;}
QComboBox {background:#f6f7fa;border:1px solid #eceef5;border-radius:7px;padding:6px 10px;font-size:11px;color:#747a91;min-width:150px;}
QComboBox::drop-down {border:0;width:20px;}
QComboBox QAbstractItemView {background:#fdfdff;color:#747a91;selection-background-color:#e5eaf8;selection-color:#4d5368;}
QScrollBar:vertical {background:transparent;width:6px;margin:3px 0;}
QScrollBar::handle:vertical {background:#e0e2e9;border-radius:3px;min-height:25px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical {height:0;}
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical {background:transparent;}
QSplitter::handle {background:transparent;width:16px;}
QMenu {background:#fdfdff;border:1px solid #e0e2e9;border-radius:9px;padding:7px;}
QMenu::item {padding:9px 24px;border-radius:6px;color:#747a91;font-size:12px;}
QMenu::item:selected {background:#e5eaf8;color:#7d8ccd;}
QMenu::separator {height:1px;background:#eceef5;margin:5px 10px;}
QDialog {background:#fdfdfe;}
QCheckBox {spacing:10px;color:#747a91;}
QToolTip {background:#fdfdff;color:#747a91;border:1px solid #eceef5;padding:6px;}
