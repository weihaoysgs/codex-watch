# Isolated real keyboard/input-method check. Never mounts the host display or DBus.
ARG BASE_IMAGE=ubuntu:20.04
FROM ${BASE_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pyqt5 libqt5svg5 fonts-noto-cjk xvfb xdotool dbus-x11 fcitx fcitx-pinyin fcitx-frontend-qt5 fcitx-module-x11 fcitx-ui-classic ibus ibus-libpinyin && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /root/.config/fcitx && printf '[Profile]\nEnabledIMList=fcitx-keyboard-us:True,pinyin:True\nIMName=pinyin\n' > /root/.config/fcitx/profile
COPY native /work/native
COPY tests /work/tests
WORKDIR /work
ENV QT_QPA_PLATFORM=xcb QT_IM_MODULE=fcitx CODEX_WATCH_IME_TEST=1 PYTHONDONTWRITEBYTECODE=1
CMD ["dbus-run-session", "--", "sh", "tests/run_input_method.sh"]
