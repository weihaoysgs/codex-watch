# Isolated compatibility check; never upgrades the host's Python/Qt.
# Build from repository root, then run the resulting image with --network none.
FROM ubuntu:20.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pyqt5 libqt5svg5 fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY dist/codex-watch_0.6.1_all.deb /tmp/codex-watch.deb
RUN dpkg -i /tmp/codex-watch.deb && rm /tmp/codex-watch.deb
COPY native /work/native
COPY tests /work/tests
WORKDIR /work
ENV QT_QPA_PLATFORM=offscreen PYTHONDONTWRITEBYTECODE=1
CMD ["sh", "-c", "python3 --version && python3 -c 'from PyQt5.QtCore import QT_VERSION_STR,PYQT_VERSION_STR; print(\"Qt\",QT_VERSION_STR,\"PyQt\",PYQT_VERSION_STR)' && python3 -m unittest discover -s tests -v && codex-watch --version && codex-watch --demo --screenshot /tmp/codex-watch.png && test -s /tmp/codex-watch.png"]
